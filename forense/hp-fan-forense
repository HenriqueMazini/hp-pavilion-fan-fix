#!/bin/bash
# ============================================================================
# hp-fan-forense - registrador de caixa-preta.
#
# Desligamentos abruptos (corte do EC, queda de energia, falha de hardware)
# nao deixam rastro no journal: ele simplesmente para. Este daemon grava uma
# linha CSV a cada 5s e faz fsync no arquivo, para que a ultima linha
# sobreviva a um corte instantaneo.
#
# O campo que mais importa e o ac_online: se ele cair para 0 antes do
# desligamento, foi perda de alimentacao externa; se ficar em 1 ate o fim,
# foi o EC ou o hardware que cortou.
#
# Log: /var/log/hp-fan-forense.csv   (rotaciona em 20 MB, guarda 1 anterior)
# ============================================================================
set -u
LOG=${LOG:-/var/log/hp-fan-forense.csv}
INTERVALO=${INTERVALO:-5}
MAXBYTES=${MAXBYTES:-20971520}

acha_hwmon() {
  local alvo=$1 h
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "$alvo" ] && { echo "$h"; return 0; }
  done
  return 1
}

HP=""; CPU=""; GPU=""; TZ=""; NVME=""
for _ in $(seq 1 60); do
  HP=$(acha_hwmon hp) && CPU=$(acha_hwmon k10temp) && break
  sleep 2
done
[ -n "$HP" ] && [ -n "$CPU" ] || { echo "hwmon indisponivel" >&2; exit 1; }
GPU=$(acha_hwmon amdgpu) || GPU=""
TZ=$(acha_hwmon acpitz)  || TZ=""
NVME=$(acha_hwmon nvme)  || NVME=""

AC=$(ls -d /sys/class/power_supply/A* 2>/dev/null | head -1)
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)

ler() { [ -n "$1" ] && cat "$1" 2>/dev/null || echo ""; }
mc()  { local v; v=$(ler "$1"); [ -n "$v" ] && awk -v x="$v" 'BEGIN{printf "%.1f", x/1000}' || echo ""; }

CAB='ts,tctl,gpu,acpitz,nvme,pwm1_enable,fan1,fan2,ac_online,bat_status,bat_capacity,cpu_mhz,load1'
[ -s "$LOG" ] || { echo "$CAB" > "$LOG"; chmod 0644 "$LOG"; }
echo "gravando em $LOG a cada ${INTERVALO}s (fsync por linha)"

while :; do
  # rotaciona sem perder a linha corrente
  if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt "$MAXBYTES" ]; then
    mv -f "$LOG" "$LOG.1"; echo "$CAB" > "$LOG"; chmod 0644 "$LOG"
  fi

  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "$(date -Is)" \
    "$(mc "$CPU/temp1_input")" \
    "$([ -n "$GPU" ] && mc "$GPU/temp1_input")" \
    "$([ -n "$TZ" ]  && mc "$TZ/temp1_input")" \
    "$([ -n "$NVME" ] && mc "$NVME/temp1_input")" \
    "$(ler "$HP/pwm1_enable")" \
    "$(ler "$HP/fan1_input")" \
    "$(ler "$HP/fan2_input")" \
    "$([ -n "$AC" ] && ler "$AC/online")" \
    "$([ -n "$BAT" ] && ler "$BAT/status")" \
    "$([ -n "$BAT" ] && ler "$BAT/capacity")" \
    "$(awk '{printf "%d", $1/1000}' /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)" \
    "$(awk '{print $1}' /proc/loadavg)" \
    >> "$LOG"

  # forca a linha para o disco: sem isto ela se perde num corte instantaneo
  sync -d "$LOG" 2>/dev/null || sync

  sleep "$INTERVALO"
done
